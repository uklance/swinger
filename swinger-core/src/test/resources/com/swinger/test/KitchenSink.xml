<panel layout="new:net.miginfocom.swing.MigLayout">
    <forEach items="people" item="person">
        <label text="First Name" />
        <textField text="prop:person.firstName" bind="true" />
        <label text="Last Name" />
        <textField text="prop:person.lastName" bind="true" />
        <eventButton text="Save Single" event="saveSingle" context="prop:person.id" constraints="wrap" />
    </forEach>
    <eventButton text="Save All" event="saveAll" />
</panel>